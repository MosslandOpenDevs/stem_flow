# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules.incomplete/
/.venv/
/.cleanup-trash/

# vendored separation engine and model weights (multi-GB, never committed)
/.sepenv/
/vendor/
/models/

# private demo audio and deployment identifiers — never publish
/public/demo/
/.openai/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]

# debug
npm-debug.log*
.dev.*.log
.*.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/
/storage/
/tsconfig.tsbuildinfo
/test-fixtures/
/*.tar.gz
