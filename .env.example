# StemFlow configuration. Copy to .env and edit.
#
#   Copy-Item .env.example .env
#
# Real environment variables take priority over this file.
#
# ---------------------------------------------------------------------------
# EXTERNAL DEPENDENCIES — you install these yourself
# ---------------------------------------------------------------------------
# StemFlow does NOT ship the separation engine or the model weights. It needs a
# CUDA audio-separator environment, FFmpeg, and two BS-Roformer checkpoints
# (~1.34 GB). See the Models section of README.md for how to obtain them.
#
# Leave a line commented out to use automatic discovery, which looks in:
#   1. this file / the environment
#   2. inside the project: models/, vendor/ffmpeg/, .sepenv/
#   3. PATH
# If none match, startup fails with an error naming the variable to set.
#
# Set a path explicitly whenever your install lives anywhere else. Run
# scripts\preflight.ps1 to see which one each component actually resolved to.

# Directory holding both .ckpt files, both .yaml configs, and download_checks.json.
#STEMFLOW_MODEL_DIR=C:\path\to\audio-separator-models

# The audio-separator executable from your CUDA environment.
#STEMFLOW_SEPARATOR_EXE=C:\path\to\.sepenv\Scripts\audio-separator.exe

# The FFmpeg executable.
#STEMFLOW_FFMPEG_EXE=C:\path\to\ffmpeg\bin\ffmpeg.exe

# ---------------------------------------------------------------------------
# SERVICE
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STEMFLOW_API_BASE=http://127.0.0.1:8000
# Defaults to <project>/storage when unset.
#STEMFLOW_STORAGE_ROOT=C:\path\to\storage
STEMFLOW_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Hours before a job is deleted. 0 keeps jobs indefinitely, which is what you
# want while experimenting — 24 will remove work you left running overnight.
STEMFLOW_RETENTION_HOURS=0

# Concurrent GPU workers. Raising this on a single GPU risks running out of VRAM.
STEMFLOW_WORKER_COUNT=1

# ---------------------------------------------------------------------------
# SEPARATION KNOBS — recorded into metadata.json so runs stay comparable
# ---------------------------------------------------------------------------
# Chunk overlap: higher is better at seams and slower. Try 8 vs 16.
STEMFLOW_MDXC_OVERLAP=8

# Mixed-precision CUDA inference. Turn off for bit-reproducible runs.
STEMFLOW_USE_AUTOCAST=true

# Blocks outbound requests from the separator subprocess so an unexpected
# download fails immediately instead of stalling. Set false only to fetch models.
STEMFLOW_OFFLINE=true
